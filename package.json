{
  "name": "nextjs-base-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "cross-env NEXT_DISABLE_ESLINT=1 NEXT_DISABLE_TYPECHECK=1 next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "type-check": "tsc --noEmit",
    "check-all": "npm run lint && npm run type-check"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.36",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/typography": "^0.5.19",
    "ai": "^6.0.169",
    "framer-motion": "^12.23.26",
    "groq-sdk": "^1.1.2",
    "isomorphic-dompurify": "^3.11.0",
    "lucide-react": "^1.14.0",
    "luxon": "^3.7.2",
    "next": "15.5.7",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "posthog-js": "^1.270.1",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.74.0",
    "resend": "^6.12.2",
    "sweph": "^2.10.3-5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "oxlint": "^1.12.0",
    "postcss": "^8.5.28",
    "supabase": "2.34.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowAny": [
        "supabase"
      ]
    }
  }
}
